---
import { features } from "@data";
---

<section id="features" class="relative scroll-mt-16">
  <!-- Mobile Top Header (scrolls normally before the sticky features track) -->
  <div class="md:hidden w-full max-w-md mx-auto text-center px-4 pt-8 pb-14 sm:pb-16">
    <h2 class="text-3xl font-extrabold tracking-tight text-white leading-[1.18] mb-3">
      See what’s happening.
      <br />
      <span class="text-white/40">Share what you know.</span>
    </h2>
    <p class="text-[#94a3b8] text-base leading-relaxed max-w-sm sm:max-w-md mx-auto">
      See incidents shared by your community, understand what happened, and
      report what you witness.
    </p>
  </div>

  <!-- Scroll track: pins the feature mockup, stepping through each feature as you scroll -->
  <div id="features-track" style={`height: ${features.length * 100}vh;`}>
    <div class="sticky top-4 sm:top-6 md:top-0 h-auto md:h-screen flex flex-col justify-center items-center overflow-hidden px-4 md:pt-0">
      <div class="max-w-7xl mx-auto w-full px-2 md:px-6 flex flex-col md:flex-row items-center justify-center gap-4 md:gap-12 lg:gap-24 xl:gap-36">
        <!-- Desktop Left: heading + selectable feature list (hidden on < md) -->
        <div class="hidden md:block w-full max-w-md lg:max-w-lg">
          <h2 class="text-3xl md:text-4xl lg:text-[42px] font-extrabold tracking-tight text-white leading-[1.2] mb-3 lg:mb-5">
            See what’s happening.
            <br />
            <span class="text-white/40">Share what you know.</span>
          </h2>
          <p class="text-[#94a3b8] text-base leading-relaxed max-w-xl mb-6 lg:mb-8">
            See incidents shared by your community, understand what happened,
            and report what you witness.
          </p>

          <ul class="flex flex-col gap-2.5">
            {features.map((f, i) => (
              <li>
                <button
                  type="button"
                  class="feature-item w-full text-left rounded-r-lg px-4 py-3.5 lg:px-5 lg:py-4 transition-colors duration-300"
                  data-index={i}
                  data-active={i === 0 ? "true" : "false"}
                >
                  <span class="flex items-center gap-4">
                    <svg
                      class="feature-icon w-5 h-5 shrink-0"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d={f.icon} />
                    </svg>
                    <span class="feature-title text-base lg:text-lg font-medium">
                      {f.title}
                    </span>
                  </span>
                  <span class="feature-body-wrap">
                    <span class="feature-body block overflow-hidden pl-9 text-sm lg:text-[0.95rem] leading-relaxed text-[#94a3b8]">
                      <span class="block pt-2">{f.body}</span>
                    </span>
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </div>

        <!-- Center / Right: Prominent Phone Media Mockup -->
        <div class="shrink-0 flex items-center justify-center">
          <div class="phone-frame phone-frame-fit relative shadow-2xl shadow-black">
            {features.map((f, i) => (
              <div
                class="feature-media absolute inset-0"
                data-active={i === 0 ? "true" : "false"}
              >
                {f.media.type === "image" ? (
                  <img src={f.media.src} alt={f.media.alt} />
                ) : (
                  <video
                    data-managed
                    src={f.media.src}
                    loop
                    muted
                    playsinline
                    preload="metadata"
                    poster={f.media.poster}
                  ></video>
                )}
              </div>
            ))}
          </div>
        </div>

        <!-- Mobile Bottom Card: Active Feature Title, Body & Step Indicator (visible on < md) -->
        <div class="md:hidden w-full max-w-sm text-center mt-3 px-2 flex flex-col items-center">
          {features.map((f, i) => (
            <div
              class="mobile-feature-desc"
              data-index={i}
              data-active={i === 0 ? "true" : "false"}
            >
              <p class="text-2xl font-semibold text-white">{f.title}</p>
              <p class="text-base text-[#94a3b8] mt-0.5">{f.body}</p>
            </div>
          ))}

          <!-- Step Indicator Dots -->
          <div class="flex items-center justify-center gap-1.5 mt-3">
            {features.map((_, i) => (
              <button
                type="button"
                class="mobile-indicator h-1.5 rounded-full transition-all duration-300"
                data-index={i}
                data-active={i === 0 ? "true" : "false"}
                aria-label={`Go to feature ${i + 1}`}
              />
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .feature-item {
    color: #94a3b8;
    border-left: 2px solid transparent;
  }
  .feature-item:hover {
    color: #ffffff;
  }
  .feature-item[data-active="true"] {
    color: #ffffff;
    background: #17191f;
    border-left-color: #40c4ff;
  }
  .feature-item[data-active="true"] .feature-icon {
    color: #40c4ff;
  }
  /* Smooth expand/collapse of the description */
  .feature-body-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
  }
  .feature-item[data-active="true"] .feature-body-wrap {
    grid-template-rows: 1fr;
  }
  .feature-body {
    min-height: 0;
  }
  .feature-media {
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  .feature-media[data-active="true"] {
    opacity: 1;
  }

  /* Mobile step indicator and descriptions */
  .mobile-indicator {
    width: 6px;
    background: rgba(255, 255, 255, 0.25);
  }
  .mobile-indicator[data-active="true"] {
    width: 22px;
    background: #40c4ff;
  }
  .mobile-feature-desc {
    display: none;
  }
  .mobile-feature-desc[data-active="true"] {
    display: block;
    animation: fadeInDesc 0.25s ease;
  }
  @keyframes fadeInDesc {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const track = document.getElementById("features-track");
  if (track) {
    const items = track.querySelectorAll<HTMLElement>(".feature-item");
    const mobileIndicators =
      track.querySelectorAll<HTMLElement>(".mobile-indicator");
    const mobileDescs = track.querySelectorAll<HTMLElement>(
      ".mobile-feature-desc",
    );
    const medias = track.querySelectorAll<HTMLElement>(".feature-media");
    const count = items.length;
    let current = -1;

    const setActive = (index: number) => {
      if (index === current) return;
      current = index;
      const flag = (el: HTMLElement, i: number) =>
        el.setAttribute("data-active", String(i === index));
      items.forEach(flag);
      mobileIndicators.forEach(flag);
      mobileDescs.forEach(flag);
      medias.forEach(flag);
      medias.forEach((m, i) => {
        const v = m.querySelector("video");
        if (!v) return;
        if (i === index) {
          v.currentTime = 0;
          v.play().catch(() => {});
        } else {
          v.pause();
        }
      });
    };

    const scrollable = () => track.offsetHeight - window.innerHeight;

    const update = () => {
      const rect = track.getBoundingClientRect();
      const total = scrollable();
      const progress =
        total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
      setActive(Math.min(count - 1, Math.floor(progress * count)));
    };

    // Clicking either desktop item or mobile indicator scrolls to that feature
    const clickables = [...Array.from(items), ...Array.from(mobileIndicators)];
    clickables.forEach((btn) => {
      btn.addEventListener("click", () => {
        const idx = Number(btn.getAttribute("data-index") || "0");
        const trackTop = track.getBoundingClientRect().top + window.scrollY;
        window.scrollTo({
          top: trackTop + ((idx + 0.5) / count) * scrollable(),
          behavior: "smooth",
        });
      });
    });

    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  }
</script>
