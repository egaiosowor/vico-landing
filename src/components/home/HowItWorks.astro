---
const steps = [
  {
    title: "Capture",
    body: "Share what you see when something happens.",
    // Video camera / recording icon
    icon: "M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z",
  },
  {
    title: "Categorize",
    body: "Add the details that help others understand what’s happening.",
    // Tag icon
    icon: "M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.386a37.288 37.288 0 004.908-3.486c.866-.757 1.04-1.996.386-2.607L11.16 3.659A2.25 2.25 0 009.568 3z M6 6h.008v.008H6V6z",
  },
  {
    title: "Verify",
    body: "Give the community a clearer picture through additional reports and context.",
    // Verified checkmark in circle icon (matching screenshot)
    icon: "M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
];
---

<section id="how" class="pt-12 pb-24 md:pt-16">
  <div class="max-w-7xl mx-auto px-4 md:px-6 flex flex-col gap-10 sm:gap-14">
    <!-- Section Header -->
    <div class="relative text-center">
      <!-- Dashed Background Strip with Decorative Frame Tiles -->
      <div
        class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-20 sm:h-24 border-y border-dashed border-white/10 pointer-events-none flex items-center justify-between overflow-hidden opacity-30 select-none"
        aria-hidden="true"
      >
        <div class="flex items-center gap-3 sm:gap-4 w-full justify-around px-2">
          <div class="w-8 sm:w-11 h-12 sm:h-14 bg-white/10 rounded-sm shrink-0"></div>
          <div class="w-8 sm:w-11 h-12 sm:h-14 bg-white/10 rounded-sm shrink-0"></div>
          <div class="w-8 sm:w-11 h-12 sm:h-14 bg-white/10 rounded-sm shrink-0"></div>
          <div class="w-8 sm:w-11 h-12 sm:h-14 bg-white/10 rounded-sm shrink-0"></div>
          <div class="w-8 sm:w-11 h-12 sm:h-14 bg-white/10 rounded-sm shrink-0"></div>
          <div class="w-8 sm:w-11 h-12 sm:h-14 bg-white/10 rounded-sm shrink-0"></div>
          <div class="w-8 sm:w-11 h-12 sm:h-14 bg-white/10 rounded-sm shrink-0"></div>
          <div class="w-8 sm:w-11 h-12 sm:h-14 bg-white/10 rounded-sm shrink-0"></div>
          <div class="w-8 sm:w-11 h-12 sm:h-14 bg-white/10 rounded-sm shrink-0"></div>
          <div class="w-8 sm:w-11 h-12 sm:h-14 bg-white/10 rounded-sm shrink-0"></div>
          <div class="w-8 sm:w-11 h-12 sm:h-14 bg-white/10 rounded-sm shrink-0"></div>
          <div class="w-8 sm:w-11 h-12 sm:h-14 bg-white/10 rounded-sm shrink-0"></div>
        </div>
      </div>

      <!-- Header Content -->
      <div class="relative z-10 max-w-3xl mx-auto px-4">
        <span class="text-sm font-medium tracking-wide text-[#94a3b8] block mb-2 sm:mb-3">
          How it works
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-[1.14]">
          From report to community awareness
        </h2>
      </div>
    </div>

    <!-- Three Cards Grid: Capture, Categorize, Verify -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5 lg:gap-6">
      {steps.map((step) => (
        <div class="bg-[#161616] border border-white/10 rounded-2xl sm:rounded-[24px] p-6 sm:p-7 flex flex-col items-center md:items-start text-center md:text-left gap-4 shadow-xl shadow-black/40 hover:border-white/20 transition-colors w-full max-w-xs mx-auto md:max-w-none">
          <svg
            class="w-6 h-6 text-white"
            fill="none"
            viewBox="0 0 24 24"
            stroke="#40c4ff"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d={step.icon} />
          </svg>
          <div>
            <h3 class="text-xl font-bold text-white mb-1">{step.title}</h3>
            <p class="text-[#94a3b8] text-base leading-relaxed">{step.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
