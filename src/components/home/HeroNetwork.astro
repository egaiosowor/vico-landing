---
interface Node {
  id: string;
  name: string;
  status: string;
  dotColor: string;
  statusColor: string;
  avatar: string;
  circleId: 'home' | 'block' | 'civic';
  x: number;
  y: number;
}

interface Edge {
  from: string;
  to: string;
  type: 'intra' | 'bridge';
}

const VW = 920;
const VH = 560;

const rawNodes: Omit<Node, 'pctX' | 'pctY'>[] = [
  // --- CIRCLE 1: HOME CIRCLE (Top Left Cluster) ---
  {
    id: 'sarah',
    name: 'Sarah M.',
    status: 'Safe',
    statusColor: 'text-[#69f0ae]',
    dotColor: 'bg-[#69f0ae]',
    avatar: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=160&auto=format&fit=crop&q=80',
    circleId: 'home',
    x: 160,
    y: 80,
  },
  {
    id: 'david',
    name: 'David K.',
    status: 'In Circle',
    statusColor: 'text-[#40c4ff]',
    dotColor: 'bg-[#40c4ff]',
    avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=160&auto=format&fit=crop&q=80',
    circleId: 'home',
    x: 88,
    y: 200,
  },
  {
    id: 'leo',
    name: 'Leo C.',
    status: 'Safe • 150m',
    statusColor: 'text-[#69f0ae]',
    dotColor: 'bg-[#69f0ae]',
    avatar: 'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=160&auto=format&fit=crop&q=80',
    circleId: 'home',
    x: 315,
    y: 250,
  },

  // --- CIRCLE 2: OAK ST. CIRCLE (Top Right Cluster) ---
  {
    id: 'marcus',
    name: 'Marcus T.',
    status: 'Verified',
    statusColor: 'text-[#40c4ff]',
    dotColor: 'bg-[#40c4ff]',
    avatar: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=160&auto=format&fit=crop&q=80',
    circleId: 'block',
    x: 700,
    y: 55,
  },
  {
    id: 'elena',
    name: 'Elena V.',
    status: 'Safe',
    statusColor: 'text-[#69f0ae]',
    dotColor: 'bg-[#69f0ae]',
    avatar: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=160&auto=format&fit=crop&q=80',
    circleId: 'block',
    x: 820,
    y: 205,
  },
  {
    id: 'chloe',
    name: 'Chloe S.',
    status: 'Safe',
    statusColor: 'text-[#69f0ae]',
    dotColor: 'bg-[#69f0ae]',
    avatar: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=160&auto=format&fit=crop&q=80',
    circleId: 'block',
    x: 690,
    y: 305,
  },
  {
    id: 'james',
    name: 'James L.',
    status: 'Nearby',
    statusColor: 'text-[#ffab40]',
    dotColor: 'bg-[#ffab40]',
    avatar: 'https://images.unsplash.com/photo-1522075469751-3a6694fb2f61?w=160&auto=format&fit=crop&q=80',
    circleId: 'block',
    x: 500,
    y: 110,
  },

  // --- CIRCLE 3: CIVIC WATCH (Bottom Cluster) ---
  {
    id: 'maya',
    name: 'Maya R.',
    status: 'In Circle',
    statusColor: 'text-[#40c4ff]',
    dotColor: 'bg-[#40c4ff]',
    avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=160&auto=format&fit=crop&q=80',
    circleId: 'civic',
    x: 175,
    y: 435,
  },
  {
    id: 'noah',
    name: 'Noah P.',
    status: 'Verified',
    statusColor: 'text-[#40c4ff]',
    dotColor: 'bg-[#40c4ff]',
    avatar: 'https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?w=160&auto=format&fit=crop&q=80',
    circleId: 'civic',
    x: 550,
    y: 470,
  },
];

const nodes = rawNodes.map((n) => ({
  ...n,
  pctX: Number(((n.x / VW) * 100).toFixed(2)),
  pctY: Number(((n.y / VH) * 100).toFixed(2)),
}));

const nodeMap = new Map(nodes.map((n) => [n.id, n]));

const edges: Edge[] = [
  // --- Intra-Circle 1 (Home Circle) ---
  { from: 'sarah', to: 'david', type: 'intra' },
  { from: 'david', to: 'leo', type: 'intra' },
  { from: 'leo', to: 'sarah', type: 'intra' },

  // --- Intra-Circle 2 (Oak St. Circle) ---
  { from: 'marcus', to: 'james', type: 'intra' },
  { from: 'james', to: 'chloe', type: 'intra' },
  { from: 'chloe', to: 'elena', type: 'intra' },
  { from: 'elena', to: 'marcus', type: 'intra' },
  { from: 'marcus', to: 'chloe', type: 'intra' },

  // --- Intra-Circle 3 (Civic Watch) ---
  { from: 'maya', to: 'noah', type: 'intra' },

  // --- Inter-Circle Bridges (Connecting Circles into Communities) ---
  // Bridge between Home Circle and Oak St. Circle
  { from: 'sarah', to: 'james', type: 'bridge' },
  { from: 'leo', to: 'james', type: 'bridge' },

  // Bridge between Home Circle and Civic Watch
  { from: 'leo', to: 'maya', type: 'bridge' },
  { from: 'david', to: 'maya', type: 'bridge' },
  { from: 'leo', to: 'noah', type: 'bridge' },

  // Bridge between Oak St. Circle and Civic Watch
  { from: 'chloe', to: 'noah', type: 'bridge' },
  { from: 'james', to: 'noah', type: 'bridge' },
];
---

<div class="relative w-full max-w-[840px] lg:max-w-[940px] aspect-[920/560] mx-auto mt-6 sm:mt-10 flex items-center justify-center select-none">
  <!-- SVG Circle Graph Canvas -->
  <svg
    class="absolute inset-0 w-full h-full pointer-events-none"
    viewBox="0 0 920 560"
    fill="none"
  >
    <defs>
      <!-- Gradient for Intra-Circle Edges -->
      <linearGradient id="intra-chord" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#40c4ff" stop-opacity="0.75" />
        <stop offset="50%" stop-color="#64748b" stop-opacity="0.75" />
        <stop offset="100%" stop-color="#69f0ae" stop-opacity="0.75" />
      </linearGradient>

      <!-- Gradient for Inter-Circle Community Bridges -->
      <linearGradient id="bridge-chord" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#ffab40" stop-opacity="0.65" />
        <stop offset="50%" stop-color="#40c4ff" stop-opacity="0.7" />
        <stop offset="100%" stop-color="#69f0ae" stop-opacity="0.65" />
      </linearGradient>
    </defs>

    <!-- Intra-Circle Connections -->
    {edges.filter((e) => e.type === 'intra').map((edge) => {
      const n1 = nodeMap.get(edge.from);
      const n2 = nodeMap.get(edge.to);
      if (!n1 || !n2) return null;

      return (
        <line
          x1={n1.x}
          y1={n1.y}
          x2={n2.x}
          y2={n2.y}
          stroke="url(#intra-chord)"
          stroke-width="1.75"
          stroke-linecap="round"
          opacity="0.85"
        />
      );
    })}

    <!-- Inter-Circle Community Bridge Connections -->
    {edges.filter((e) => e.type === 'bridge').map((edge) => {
      const n1 = nodeMap.get(edge.from);
      const n2 = nodeMap.get(edge.to);
      if (!n1 || !n2) return null;

      return (
        <line
          x1={n1.x}
          y1={n1.y}
          x2={n2.x}
          y2={n2.y}
          stroke="url(#bridge-chord)"
          stroke-width="1.75"
          stroke-linecap="round"
          opacity="0.85"
        />
      );
    })}
  </svg>

  <!-- Community Member Avatars (Clean Static Node Graph) -->
  {nodes.map((node) => (
    <div
      class="absolute z-20 -translate-x-1/2 -translate-y-1/2 pointer-events-none"
      style={`left: ${node.pctX}%; top: ${node.pctY}%;`}
    >
      <!-- Avatar Frame with Status Indicator Dot -->
      <div class="relative p-0.5 rounded-full bg-[#151929] border border-[#2a324b] shadow-xl shadow-black/70">
        <img
          src={node.avatar}
          alt={node.name}
          class="w-10 h-10 sm:w-12 sm:h-12 rounded-full object-cover"
          loading="lazy"
        />
        <span class={`absolute bottom-0 right-0 w-3 h-3 sm:w-3.5 sm:h-3.5 rounded-full ${node.dotColor} ring-2 ring-[#0D0D0D]`}></span>
      </div>
    </div>
  ))}
</div>
