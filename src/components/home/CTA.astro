---
---

<section class="py-12 sm:py-20 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <!-- Big Rounded Canvas Card with cta-bg.jpg background -->
    <div
      class="relative overflow-hidden rounded-[32px] sm:rounded-[40px] border border-gray-200 shadow-2xl shadow-black/30 px-6 pt-8 pb-0 sm:p-10 md:p-12 lg:p-16 sm:pb-0 md:pb-0 lg:pb-0 bg-[#e5e5e5]"
    >
      <!-- Background Image -->
      <img
        src="/assets/cta-bg.jpg"
        alt=""
        class="absolute inset-0 w-full h-full object-cover pointer-events-none"
        loading="lazy"
      />

      <!-- Horizontal Flex Layout -->
      <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8 md:gap-8 lg:gap-16">
        <!-- Left Column: Copy & Actions -->
        <div class="max-w-md lg:max-w-xl text-center md:text-left pt-4 sm:pt-8 md:pt-0 pb-4 sm:pb-10 md:pb-12 lg:pb-16">
          <!-- Main Headline -->
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[#0D0D0D] leading-[1.12]">
            Stay connected to what’s happening.
          </h2>

          <!-- Subtitle -->
          <p class="text-[#52525b] text-base sm:text-lg mt-4 mb-6 sm:mb-8 leading-relaxed max-w-lg">
            Join your community on Vico and stay connected to the people and events around you.
          </p>

          <!-- Action Button -->
          <div class="flex items-center justify-center md:justify-start">
            <a
              href="#"
              class="demo-link inline-flex items-center justify-center font-bold px-7 py-3.5 rounded-full bg-[#0D0D0D] text-white hover:bg-black/85 shadow-lg shadow-black/20 hover:scale-[1.02] active:scale-[0.98] transition-all text-sm sm:text-base"
            >
              Get started for free
            </a>
          </div>
        </div>

        <!-- Right Column: Hand with Phone Mockup -->
        <div class="shrink-0 flex items-end justify-center md:justify-end self-center md:self-end">
          <img
            src="/assets/hand.png"
            alt="Vico app in hand"
            class="w-[350px] sm:w-[380px] md:w-[360px] lg:w-[420px] max-w-full h-auto object-contain select-none pointer-events-none drop-shadow-2xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>
