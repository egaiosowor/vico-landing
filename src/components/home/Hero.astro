---
import HeroNetwork from "./HeroNetwork.astro";
---

<section class="mt-10 md:mt-12 py-12 sm:py-16 overflow-x-clip">
  <div class="max-w-7xl mx-auto px-4 md:px-6 flex flex-col items-center">
    <!-- Text Content (Centered Above) -->
    <div class="flex flex-col items-center text-center max-w-3xl">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.08] text-white">
        Helping communities stay aware and connected.
      </h1>
      <p class="text-[#94a3b8] text-base sm:text-lg my-6 max-w-2xl leading-relaxed">
        Vico is a community safety network where people share real incidents,
        backed by video and verified by the people around them.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
        <a
          href="#"
          class="btn-primary inline-flex items-center justify-center font-bold px-7 py-3.5 rounded-full text-[#0D0D0D] shadow-lg hover:shadow-[#ffab40]/25 transition-all"
        >
          Get started for free
        </a>
      </div>
    </div>

    <!-- Community Connection Network Visual Component -->
    <HeroNetwork />
  </div>
</section>
